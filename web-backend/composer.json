{
  "name": "jawlinefit/web-backend",
  "description": "JawlineFit production API and administration console",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.1",
    "ext-curl": "*",
    "ext-fileinfo": "*",
    "ext-gd": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "firebase/php-jwt": "^6.11",
    "google/apiclient": "^2.18"
  },
  "autoload": {
    "psr-4": {"JawlineFit\\": "includes/"}
  },
  "config": {
    "allow-plugins": {},
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
