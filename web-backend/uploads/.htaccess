Options -Indexes -ExecCGI
<FilesMatch "^(?!.*\.(?:jpe?g|png|webp|gif|mp4)$).*$">
    Require all denied
</FilesMatch>
<FilesMatch "\.(?:php|php3|php4|php5|phtml|phar|cgi|pl|py|sh)$">
    Require all denied
</FilesMatch>
RemoveHandler .php .php3 .php4 .php5 .phtml .phar .cgi .pl .py .sh
RemoveType .php .php3 .php4 .php5 .phtml .phar .cgi .pl .py .sh
<IfModule mod_mime.c>
    AddType text/plain .php .php3 .php4 .php5 .phtml .phar .cgi .pl .py .sh
</IfModule>
Header always set X-Content-Type-Options "nosniff"
